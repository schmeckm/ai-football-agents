NVIDIA_API_KEY=nvapi-your-key-here
MODEL_ID=meta/llama-3.1-8b-instruct
# Optional: protect /api/state from spoofing (same value in Match Setup → Spectator token)
STATE_TOKEN=

# --- MQTT / Unified Namespace (optional) ---
# Set MQTT_ENABLED=1 and run a broker (e.g. Mosquitto). Spectator uses MQTT_WS_URL if set.
MQTT_ENABLED=0
MQTT_BROKER=localhost
MQTT_PORT=1883
# WebSocket URL for browser spectator (Mosquitto: listener 9001 + protocol websockets)
MQTT_WS_URL=ws://localhost:9001
MQTT_UNS_PREFIX=aspire/basel/demo/football
# MQTT_USERNAME=
# MQTT_PASSWORD=
# MQTT_CLIENT_ID=football-backend
# Per-player telemetry topics (throttled): aspire/.../agent/{player}/telemetry
MQTT_AGENT_TELEMETRY=0
MQTT_AGENT_INTERVAL_SEC=1.0

# Sparkplug B (protobuf) — parallel to JSON UNS when MQTT_ENABLED=1
SPARKPLUG_ENABLED=0
SPARKPLUG_GROUP_ID=Aspire
SPARKPLUG_NODE_ID=football-server
SPARKPLUG_DEVICE_ID=match
